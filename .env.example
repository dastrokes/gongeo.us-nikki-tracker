# Main Supabase project: authentication, users, statistics, and feedback workflow
# SUPABASE_DATABASE_URL is the project API URL, not a PostgreSQL connection string.
SUPABASE_DATABASE_URL=https://your-main-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_main_project_publishable_key
SUPABASE_SECRET_KEY=your_main_project_secret_key

# Cloudflare catalog API
# Required. For a local Worker use http://localhost:8787/v1.
NUXT_PUBLIC_DATA_API_BASE_URL=https://data.gongeo.us/v1

# Optional only when running the D1-derived Pinecone publisher directly here.
# Normal publishing loads these from the data processor environment.
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_SEARCH_HOST=https://your-index-host

# Maintainer-only item-search feedback workflow
MAINTAINER_EMAILS=maintainer@example.com
# Comma-separated additions to the built-in production/local allowlist.
ITEM_SEARCH_MAINTAINER_ALLOWED_HOSTS=

# Needed by the operator purge command for site-owned tags (stats, sitemap, etc.).
# Catalog-only tags use the Worker settings below instead.
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token

# Worker-owned catalog administration. These values are server/operator-only.
CLOUDFLARE_CACHE_PURGE_URL=https://data.gongeo.us/_internal/cache/purge
CLOUDFLARE_DATA_TOKEN=use_the_same_value_across_all_three_projects

# Public application configuration
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_IMAGEKIT_BASE_URL=https://ik.imagekit.io/gongeous
NUXT_PUBLIC_IMAGE_CDN_BASE_URL=https://cdn.gongeo.us
NUXT_PUBLIC_IMAGE_PROVIDER=ipx
NUXT_PUBLIC_ENABLE_ADSENSE=false
# This value is exposed to the browser; do not use a privileged secret here.
GONGEOUS_API_KEY=your_public_stats_api_key

# Optional error reporting
SENTRY_DSN=

# Optional Open Graph image-generation overrides
OG_HOST=127.0.0.1
OG_PORT=3000
PLAYWRIGHT_EXECUTABLE_PATH=
